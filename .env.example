# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/shine26?schema=public"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-here"

# Public base URL of the app. REQUIRED in production: used for links in QR codes
# and emails (the Host header is never trusted for this in production).
# NEXTAUTH_URL="https://your-domain.example"

# Shared secret for /api/cron/reminders (send as "Authorization: Bearer <secret>").
# REQUIRED in production — the endpoint is disabled without it.
CRON_SECRET="generate-a-long-random-string"

# Number of reverse proxies in front of the app (Railway/Vercel = 1).
# Used to read the real client IP from X-Forwarded-For for rate limiting.
TRUSTED_PROXY_HOPS="1"

# Set to "true" ONLY for a self-signed SMTP relay you control (disables certificate checks)
SMTP_ALLOW_INSECURE_TLS="false"
