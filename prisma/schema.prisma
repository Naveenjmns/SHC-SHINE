// Prisma Schema for SHINE 26 Event Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum Role {
  STUDENT
  COORDINATOR
  ADMIN
  FOOD_COORDINATOR
}

enum EventCategory {
  ON_STAGE
  OFF_STAGE
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// ===== Models =====

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String?
  role           Role     @default(STUDENT)
  college        String?
  avatarUrl      String?
  foodPreference String?  @default("VEG") // VEG, NON_VEG
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  registrations      Registration[]   // Events the user has registered for (as student)
  coordEvents        Event[]          @relation("LegacyCoordinatorEvents")
  staffCoordEvents   Event[]          @relation("StaffCoordinatorEvents")
  studentCoordEvents Event[]          @relation("StudentCoordinatorEvents")

  @@map("users")
}

model EventEdition {
  id                   String   @id @default(cuid())
  name                 String   @default("SHINE")
  edition              String   @default("2026")
  slug                 String   @unique
  isActive             Boolean  @default(true)
  status               String   @default("LIVE") // DRAFT, UPCOMING, LIVE, COMPLETED
  tagline              String?  @default("Where Ideas Begin to Shine")
  metadataText         String?  @default("TECHNOLOGY • INNOVATION • CREATIVITY")
  description          String?  @default("SHINE is the annual flagship intercollegiate symposium organized by the Dept. of Computer Applications (PG), Sacred Heart College (Autonomous).")
  venue                String?  @default("SGB Main Auditorium, Sacred Heart College, Tirupattur")
  startDate            DateTime?
  endDate              DateTime?
  logoUrl              String?
  secondaryLogoUrl     String?
  faviconUrl           String?
  heroBgUrl            String?
  primaryCtaText       String?  @default("EXPLORE SHINE →")
  primaryCtaLink       String?  @default("#events")
  themePrimaryAccent   String?  @default("#FF6B1A")
  themeSecondaryAccent String?  @default("#D9A441")
  themeBgColor         String?  @default("#FAF8F5")

  // Stage View College Header Banner (CMS Driven)
  institutionName      String?  @default("SACRED HEART COLLEGE (AUTONOMOUS), TIRUPATTUR")
  institutionCrestUrl  String?
  accreditationText    String?  @default("Accredited by NAAC (5th Cycle - Under RAF) with a CGPA of 3.53/4 at 'A++' Grade, Affiliated to Thiruvalluvar University Tirupattur - 635 601")
  jubileeBadgeUrl      String?
  hostDepartment       String?  @default("DEPARTMENT OF COMPUTER APPLICATIONS (PG)")
  acronymExpansion     String?  @default("SACRED HEART INFORMATICS NETWORK FOR ENTERPRISES")
  deptLogoUrl          String?
  stageHeaderBannerUrl String?

  // Reusable Institution & Department Details
  institutionShortName String?  @default("SHC")
  institutionLocation  String?  @default("Tirupattur — 635 601, Tamil Nadu")
  institutionAbout     String?  @default("Premier institution recognized with NAAC accreditation, providing world-class infrastructure, research excellence, and academic distinction.")
  departmentAbout      String?  @default("Nurturing top-tier engineers, developers, and technical leaders through state-of-the-art labs, hands-on curricula, and hackathons.")
  departmentProgram    String?  @default("MCA Program")
  contactEmail         String?  @default("shine@shctpt.edu")
  contactPhone         String?  @default("+91 4175 240464")
  websiteUrl           String?
  participantFee            Float    @default(0)
  isRegistrationOpen        Boolean  @default(true)
  registrationClosedNotice  String?  @default("Registrations for this edition are currently closed. Please contact the event coordinators for queries.")
  prizePool                 String?  @default("₹25K+")
  expectedDelegates         String?  @default("500+")

  // Symposium Rules & Guidelines
  rulesEligibilityTitle     String?  @default("Eligibility & Registration")
  rulesEligibilityText      String?  @default("Open to all bona fide UG and PG students of Computer Science, Applications, IT, and related engineering disciplines with valid college ID cards.")
  rulesTimingsTitle         String?  @default("Reporting & Timings")
  rulesTimingsText          String?  @default("Participants must report at the registration desk by 09:00 AM sharp on Sep 17, 2026. Spot registrations close at 10:30 AM.")
  rulesChampionshipTitle    String?  @default("Overall Championship")
  rulesChampionshipText     String?  @default("The institution securing maximum cumulative points across both On-Stage and Off-Stage events will be crowned the SHINE Overall Champions.")

  // Default Competition Awards (Dynamic for Leaderboard)
  defaultFirstPrize         String?  @default("Cash Prize + Trophy + Certificate")
  defaultSecondPrize        String?  @default("Cash Prize + Merit Certificate")
  defaultThirdPrize         String?  @default("Distinction Certificate")

  // Student Portal Stage Mode (Event Winners Display) Visibility
  showStageModeInStudentPortal Boolean @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  events        Event[]
  navItems      NavigationItem[]
  sponsors      Sponsor[]
  scheduleItems ScheduleItem[]

  delegations   Delegation[]

  @@map("event_editions")
}

model Delegation {
  id                 String             @id @default(cuid())
  editionId          String
  collegeName        String
  department         String?
  teamName           String?
  teamLeadName       String
  teamLeadEmail      String
  teamLeadPhone      String
  staffInchargeName  String?
  staffInchargeEmail String?
  staffInchargePhone String?
  totalFee           Float              @default(0)
  paymentStatus      String             @default("PENDING") // PENDING, PAID, VERIFIED
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  edition            EventEdition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  members            DelegationMember[]
  registrations      Registration[]

  // PERFORMANCE: Indexes for frequently queried columns
  @@index([editionId])
  @@index([teamLeadEmail])
  @@index([collegeName])
  @@map("delegations")
}

model DelegationMember {
  id               String         @id @default(cuid())
  delegationId     String
  name             String
  email            String
  phone            String
  isTeamLead       Boolean        @default(false)
  badgeCode        String         @unique
  foodTokenCode    String         @unique
  foodPreference   String         @default("VEG") // VEG, NON_VEG
  eventCheckedIn    Boolean        @default(false)
  eventCheckedInAt  DateTime?
  eventCheckedInBy  String?
  foodTokenClaimed  Boolean        @default(false)
  foodClaimedAt     DateTime?
  foodClaimedBy     String?
  qrData            String?        @db.Text // Event Pass QR Code Data URL
  foodQrData        String?        @db.Text // Food Token QR Code Data URL
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  delegation       Delegation     @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  registrations    Registration[]

  // PERFORMANCE: Indexes for frequently queried columns
  @@index([delegationId])
  @@index([email])
  @@map("delegation_members")
}

model ScheduleItem {
  id          String       @id @default(cuid())
  editionId   String
  time        String
  title       String
  venue       String?
  description String?
  tag         String?
  order       Int          @default(0)
  edition     EventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("schedule_items")
}

model NavigationItem {
  id        String       @id @default(cuid())
  editionId String
  label     String
  url       String
  order     Int          @default(0)
  isEnabled Boolean      @default(true)
  edition   EventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("navigation_items")
}

model Sponsor {
  id         String       @id @default(cuid())
  editionId  String
  name       String
  logoUrl    String
  tier       String?      @default("TITLE") // TITLE, GOLD, MEDIA, PARTNER
  websiteUrl String?
  order      Int          @default(0)
  edition    EventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("sponsors")
}

model Event {
  id                   String        @id @default(cuid())
  editionId            String?
  name                 String
  description          String?
  category             EventCategory
  fee                  Float         @default(0)
  capacity             Int?
  venue                String?
  dateTime             DateTime
  rules                      String?       @db.Text
  imageUrl                   String?
  logoUrl                    String?
  staffCoordinatorName       String?
  staffCoordinatorEmail      String?
  staffCoordinatorPhone      String?
  staffCoordinatorImageUrl   String?
  studentCoordinatorName     String?
  studentCoordinatorEmail    String?
  studentCoordinatorPhone    String?
  studentCoordinatorImageUrl String?
  staffCoordinatorId         String?
  studentCoordinatorId       String?
  coordinatorId              String?
  hasPrelims                 Boolean       @default(false)
  prelimsDateTime            DateTime?
  prelimsVenue               String?
  prelimsRules               String?       @db.Text
  firstPrize                 String?       @default("Cash Prize + Trophy + Certificate")
  secondPrize                String?       @default("Cash Prize + Merit Certificate")
  thirdPrize                 String?       @default("Distinction Certificate")
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  // Relations
  edition            EventEdition?  @relation(fields: [editionId], references: [id])
  coordinator        User?          @relation("LegacyCoordinatorEvents", fields: [coordinatorId], references: [id])
  staffCoordinator   User?          @relation("StaffCoordinatorEvents", fields: [staffCoordinatorId], references: [id])
  studentCoordinator User?          @relation("StudentCoordinatorEvents", fields: [studentCoordinatorId], references: [id])
  registrations      Registration[]

  // PERFORMANCE: Index for edition-scoped queries
  @@index([editionId])
  @@map("events")
}

model Registration {
  id                 String             @id @default(cuid())
  userId             String
  eventId            String
  delegationId       String?
  delegationMemberId String?
  status             RegistrationStatus @default(PENDING)
  result             String?
  score              Float?
  attended           Boolean            @default(false)
  checkedInAt        DateTime?
  checkedInBy        String?
  isPrelimsParticipant Boolean          @default(false)
  prelimsStatus      String?            @default("PENDING")
  prelimsScore       Float?
  prelimsNotes       String?
  reminderSentAt        DateTime?
  prelimsReminderSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegation       Delegation?       @relation(fields: [delegationId], references: [id], onDelete: SetNull)
  delegationMember DelegationMember? @relation(fields: [delegationMemberId], references: [id], onDelete: SetNull)

  // A user can only register once per event
  @@unique([userId, eventId])
  // PERFORMANCE: Indexes for frequently filtered/joined columns
  @@index([eventId])
  @@index([userId])
  @@index([delegationId])
  @@index([delegationMemberId])
  @@index([status])
  @@map("registrations")
}

model SmtpSetting {
  id        String   @id @default("default")
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @default("")
  password  String   @default("")
  fromEmail String   @default("")
  fromName  String   @default("")
  replyTo   String?
  updatedAt DateTime @updatedAt

  @@map("smtp_settings")
}

model EmailBroadcast {
  id             String   @id @default(cuid())
  subject        String
  message        String
  targetAudience String   @default("ALL") // ALL, EVENT
  targetEventId  String?
  recipientCount Int      @default(0)
  status         String   @default("SENT") // SENT, FAILED, PARTIAL
  sentBy         String?
  sentAt         DateTime @default(now())

  @@map("email_broadcasts")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // e.g. "USER_LOGIN", "USER_REGISTER", "EVENT_REGISTRATION", "REGISTRATION_STATUS_UPDATE", "RESULT_UPDATE", "EVENT_CREATE", "EVENT_UPDATE", "EVENT_DELETE", "EMAIL_BROADCAST", "SMTP_UPDATE", "EDITION_UPDATE"
  actorId     String?
  actorName   String?
  actorEmail  String?
  actorRole   String?
  targetType  String?  // e.g. "Event", "Registration", "User", "Email", "System"
  targetId    String?
  targetTitle String?  // e.g. Event name, User name, Subject
  details     String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model ImageStore {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String   @default("image/png")
  data      Bytes    @db.ByteA
  size      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([filename])
  @@map("image_stores")
}

